# --- AI provider ---
# One of: gemini | groq | openai_compatible
AI_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Any OpenAI-compatible endpoint (LM Studio, vLLM, OpenRouter, etc.)
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# --- Voice (not implemented yet, reserved for Phase 2) ---
STT_PROVIDER=
TTS_PROVIDER=
LEO_WAKE_WORD=leo

# --- Feature flags ---
SCREEN_CAPTURE_ENABLED=false
BROWSER_AUTOMATION_ENABLED=false

# --- Permissions ---
# Default max permission level LEO may act at without asking:
# OBSERVE | NORMAL | PRIVILEGED | HIGH_RISK
DEFAULT_MAX_AUTO_PERMISSION=NORMAL

# --- Paths ---
LEO_DATA_DIR=./data
LEO_LOG_DIR=./logs

# Set true to let LEO look at your screen (screenshots go to your AI provider only when you ask)
# SCREEN_CAPTURE_ENABLED=true
# Set true to run the browser invisibly
# LEO_BROWSER_HEADLESS=false
